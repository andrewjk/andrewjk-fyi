  "dependencies": {
    "@redraft/adapter-cloudflare": "^0.1.7",
    "@redraft/site": "^0.3.3",
    "@torpor/adapter-cloudflare": "^1.0.15",
    "@torpor/build": "^1.6.1",
    "dotenv": "^18.0.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
