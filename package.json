{
  "name": "andrewjk-fyi",
  "version": "0.0.1",
  "description": "A Redraft site",
  "type": "module",
  "scripts": {
    "dev": "tb --dev",
    "build": "tsc --noEmit && tb --build",
    "preview": "tb --preview",
    "check": "tsc --noEmit",
    "db:list": "wrangler d1 migrations list DB --remote",
    "db:push": "wrangler d1 migrations apply DB --remote",
    "tail": "wrangler tail"
  },
